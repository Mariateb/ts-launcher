<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TS Launcher" Width="1200" Height="800" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterScreen" FontFamily="Tahoma">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
      <GradientStop Color="#2E2758" Offset="0"/>
      <GradientStop Color="#1A1A31" Offset="0.42"/>
      <GradientStop Color="#0D0D18" Offset="1"/>
    </LinearGradientBrush>
  </Window.Background>
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentLight" Color="#B79CFF"/>
    <!-- Big Picture buttons: a flat fill, no outline; turns white when focused with the keyboard or a controller -->
    <Style x:Key="FlatBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#E3E2EE"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#38FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="Background" Value="#ECEBF5"/>
                <Setter Property="Foreground" Value="#14151F"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Library filters and sort: text that becomes a pill when chosen, like Big Picture's home tabs -->
    <Style x:Key="TabBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#B4B6C8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- On / off switch for settings -->
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="#33FFFFFF" BorderBrush="Transparent" BorderThickness="2">
              <Ellipse x:Name="knob" Width="18" Height="18" Margin="2,0" Fill="#ECEBF5" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#5BA32B" CornerRadius="2" Padding="28,11">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#6FC234"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="#6FC234"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#4A8A22"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Left navigation: icon over a short label, accent bar on the current page -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#8D8FA8"/>
      <Setter Property="Height" Value="70"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="hl" Margin="9,3" CornerRadius="6" Background="Transparent"/>
              <Border x:Name="bar" Width="3" Margin="0,18" HorizontalAlignment="Left" CornerRadius="0,2,2,0" Background="{DynamicResource Accent}" Visibility="Hidden"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"/>
                <ContentPresenter HorizontalAlignment="Center" Margin="0,7,0,0" TextBlock.FontSize="11" TextBlock.FontWeight="SemiBold"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="hl" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="#ECEBF5"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="hl" Property="Background" Value="#1CFFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="hl" Property="Background" Value="#ECEBF5"/>
                <Setter Property="Foreground" Value="#14151F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TileBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#F0EEF8"/>
      <Setter Property="Background" Value="#17FFFFFF"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Height" Value="74"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="2" CornerRadius="4" Padding="16,10">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#55FFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PillToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#B8B6CC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="b" Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#38FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Optional backdrop: the art of a game, blurred once and cached -->
    <Border x:Name="BgCache" ClipToBounds="True" IsHitTestVisible="False">
      <Grid Margin="-60">
        <Image x:Name="BgA" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="LowQuality">
          <Image.Effect><BlurEffect Radius="48" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
          <Image.CacheMode><BitmapCache RenderAtScale="0.5"/></Image.CacheMode>
        </Image>
        <Image x:Name="BgB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="LowQuality">
          <Image.Effect><BlurEffect Radius="48" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
          <Image.CacheMode><BitmapCache RenderAtScale="0.5"/></Image.CacheMode>
        </Image>
      </Grid>
    </Border>
    <Border x:Name="BgShade" IsHitTestVisible="False" Visibility="Collapsed">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#990F1122" Offset="0"/>
          <GradientStop Color="#C80F1122" Offset="0.45"/>
          <GradientStop Color="#F50F1122" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="92"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="NavRail" Grid.Column="0" Background="#8C0A0B16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="東方" FontSize="25" FontWeight="Bold" Foreground="#E0435A" HorizontalAlignment="Center"
                     Margin="0,20,0,24" ToolTip="TS Launcher"/>
          <StackPanel>
            <RadioButton x:Name="HomeBtn" Style="{StaticResource NavBtn}" GroupName="nav" Tag="&#xE8F1;" Content="Library"/>
            <RadioButton x:Name="LangsBtn" Style="{StaticResource NavBtn}" GroupName="nav" Tag="&#xE774;" Content="Languages"/>
            <RadioButton x:Name="StatsBtn" Style="{StaticResource NavBtn}" GroupName="nav" Tag="&#xE9D2;" Content="Stats"/>
            <RadioButton x:Name="SettingsBtn" Style="{StaticResource NavBtn}" GroupName="nav" Tag="&#xE713;" Content="Settings"/>
            <RadioButton x:Name="HelpBtn" Style="{StaticResource NavBtn}" GroupName="nav" Tag="&#xE897;" Content="Help"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <DockPanel Grid.Column="1">
        <Border x:Name="TopBar" DockPanel.Dock="Top" Padding="28,16,28,4">
          <DockPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="12" Foreground="#8D8FA8" VerticalAlignment="Center"
                       Margin="24,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
            <Grid MaxWidth="560" HorizontalAlignment="Left" Width="560" VerticalAlignment="Center">
              <TextBox x:Name="SearchBox" Background="Transparent" Foreground="#F0EEF8" BorderThickness="0" CaretBrush="#B79CFF"
                       Padding="30,7,12,7" FontSize="15" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"/>
              <Rectangle x:Name="SearchLine" Height="1.5" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.35"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#8D8FA8" IsHitTestVisible="False"
                         Margin="4,0,0,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SearchHint" Text="Search your games" IsHitTestVisible="False"
                         Foreground="#6E7086" FontSize="15" Margin="32,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </DockPanel>
        </Border>
        <Border x:Name="HintBar" DockPanel.Dock="Bottom" Padding="28,8,28,12">
          <DockPanel>
            <StackPanel x:Name="HintLeft" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"/>
            <StackPanel x:Name="HintRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <Border x:Name="NoticeBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="28,8,28,0" Padding="16,9" Background="#3A2E1A" CornerRadius="4">
          <DockPanel>
            <Button x:Name="NoticeClose" DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatBtn}" Padding="9,3" Margin="8,0,0,0" Background="Transparent"/>
            <Button x:Name="NoticeAction" DockPanel.Dock="Right" Style="{StaticResource FlatBtn}" Padding="12,4" Margin="12,0,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="NoticeText" Foreground="#F5E6C4" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>
        <Border x:Name="NowPlaying" DockPanel.Dock="Top" Visibility="Collapsed" Margin="28,8,28,0" Padding="16,10" CornerRadius="4">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#CC1B3A2A" Offset="0"/>
              <GradientStop Color="#33151826" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel x:Name="NowPlayingPanel"/>
        </Border>
        <Grid>
          <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Hidden" Padding="0" Focusable="False">
            <StackPanel>
              <StackPanel x:Name="RecentPanel" Visibility="Collapsed" Margin="0,2,0,0">
                <StackPanel x:Name="RecentHost"/>
                <TextBlock x:Name="FocusTitle" Margin="28,0,28,0" FontSize="30" FontWeight="Bold" Foreground="#F4F3FA" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FocusInfo" Margin="29,4,28,0" FontSize="13" FontWeight="SemiBold" Foreground="#9FA2B8" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <DockPanel x:Name="LibBar" Margin="24,28,28,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="LibLabel" Foreground="#8D8FA8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                             TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                  <Button x:Name="SortBtn" Style="{StaticResource TabBtn}"/>
                </StackPanel>
                <StackPanel x:Name="FilterTabs" Orientation="Horizontal" VerticalAlignment="Center"/>
              </DockPanel>
              <StackPanel x:Name="GamePanel" Margin="0,0,0,24"/>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="StatsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Padding="28,10,28,18" Background="Transparent">
            <StackPanel x:Name="StatsPanel" MaxWidth="1100" HorizontalAlignment="Left"/>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Grid>

    <Grid x:Name="Overlay" Visibility="Collapsed" Background="#D90A0A14">
      <Border x:Name="Dialog" Width="860" MaxHeight="760" Background="#171929" CornerRadius="6" ClipToBounds="True"
              BorderBrush="#1FFFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <DockPanel>
          <Grid x:Name="DlgHeaderGrid" DockPanel.Dock="Top" MinHeight="150">
            <Border x:Name="DlgHeader" CornerRadius="5,5,0,0"/>
            <Border x:Name="DlgShade" CornerRadius="5,5,0,0" Visibility="Collapsed">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#10000000" Offset="0"/>
                  <GradientStop Color="#40000000" Offset="0.45"/>
                  <GradientStop Color="#FF171929" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
              <Button x:Name="DlgFav" Content="☆" Style="{StaticResource FlatBtn}" Margin="0,0,8,0" Padding="11,5"
                      Background="#80000000" ToolTip="Favorite (F)"/>
              <Button x:Name="DlgClose" Content="✕" Style="{StaticResource FlatBtn}" Padding="11,5"
                      Background="#80000000" ToolTip="Close (Esc)"/>
            </StackPanel>
            <DockPanel Margin="26,20,26,18" VerticalAlignment="Bottom">
              <Image x:Name="DlgIcon" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,16,2" VerticalAlignment="Bottom"/>
              <Button x:Name="DlgPlay" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" VerticalAlignment="Bottom" Margin="20,0,0,0"/>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="DlgSub" Foreground="#DDFFFFFF" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="DlgTitle" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="DlgStats" Foreground="#D8FFFFFF" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </Grid>
          <Border x:Name="DlgFooter" DockPanel.Dock="Bottom" Padding="22,12,22,16" BorderThickness="0,1,0,0">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#008B5CF6" Offset="0"/>
                <GradientStop Color="#608B5CF6" Offset="0.5"/>
                <GradientStop Color="#008B5CF6" Offset="1"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <DockPanel>
              <CheckBox x:Name="ThpracChk" DockPanel.Dock="Left" Style="{StaticResource PillToggle}" Content="thprac" Tag="&#xE916;" Margin="0,0,8,0"
                        ToolTip="Attach thprac (the practice tool) once the game has started. Remembered for this game."/>
              <CheckBox x:Name="CustomChk" DockPanel.Dock="Left" Style="{StaticResource PillToggle}" Content="Game settings mode" Tag="&#xE713;"
                        ToolTip="Open the game's own settings program (custom.exe) in the chosen language, instead of the game"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="VanillaBtn" Content="Play original" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Start the game without any thcrap patch"/>
                <Button x:Name="CoverBtn" Content="Cover…" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Pick this game's cover and banner from every option on SteamGridDB, or use your own picture"/>
                <Button x:Name="ShotsBtn" Content="Screenshots" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="This game's screenshots: open, copy or delete them"/>
                <Button x:Name="ReplaysBtn" Content="Replays" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Browse, rename, back up or delete this game's replays"/>
                <Button x:Name="SavesBtn" Content="Saves ▾" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Back up / restore this game's save (score.dat), open its folders"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid>
            <ScrollViewer x:Name="LangScroll" VerticalScrollBarVisibility="Auto" Padding="21,14,21,10">
              <StackPanel>
                <TextBlock x:Name="LangHint" Foreground="#8E8CA6" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,8" TextWrapping="Wrap"/>
                <UniformGrid x:Name="LangPanel" Columns="3"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="CoverScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,14,12,10">
              <StackPanel x:Name="CoverPanel"/>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
    <Grid x:Name="SetupOverlay" Visibility="Collapsed" Background="#F20C0B18">
      <Border x:Name="SetupCard" Width="680" Background="#171929" CornerRadius="6" BorderBrush="#1FFFFFFF" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,30">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <StackPanel x:Name="SetupPanel"/>
      </Border>
    </Grid>
  </Grid>
</Window>