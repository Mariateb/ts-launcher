<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TS Launcher" Width="1200" Height="800" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
      <GradientStop Color="#2E2758" Offset="0"/>
      <GradientStop Color="#1A1A31" Offset="0.42"/>
      <GradientStop Color="#0D0D18" Offset="1"/>
    </LinearGradientBrush>
  </Window.Background>
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentLight" Color="#B79CFF"/>
    <Style x:Key="FlatBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#DEDCEA"/>
      <Setter Property="Background" Value="#272A44"/>
      <Setter Property="BorderBrush" Value="#383C5E"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#433A78"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="Background" Value="#433A78"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2E2858"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#5BA32B" CornerRadius="2" Padding="28,11">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#6FC234"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="#6FC234"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#4A8A22"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RoundBtn" TargetType="ButtonBase">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="Margin" Value="11,0"/>
      <Setter Property="Foreground" Value="#F0EEF8"/>
      <Setter Property="Background" Value="#272A44"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Grid>
              <Ellipse x:Name="ring" Margin="-5" Stroke="{DynamicResource AccentLight}" StrokeThickness="3" Opacity="0"/>
              <Ellipse x:Name="disc" Fill="{TemplateBinding Background}" Stroke="#383C5E" StrokeThickness="1"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                <Setter TargetName="disc" Property="Fill" Value="#433A78"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="disc" Property="Fill" Value="#2E2858"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TileBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#F0EEF8"/>
      <Setter Property="Background" Value="#222440"/>
      <Setter Property="BorderBrush" Value="#33365A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Height" Value="74"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="16,10">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FFFFFF"/>
                <Setter TargetName="b" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PillToggle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#B8B6CC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="b" Background="#222440" BorderBrush="#33365A" BorderThickness="1" CornerRadius="2" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLight}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <DockPanel>
      <Border x:Name="HeaderBar" DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="22,10">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F00C0B18" Offset="0"/>
            <GradientStop Color="#900C0B18" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#008B5CF6" Offset="0"/>
            <GradientStop Color="#708B5CF6" Offset="0.5"/>
            <GradientStop Color="#008B5CF6" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="東方" FontSize="28" Foreground="#E0435A" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="TS Launcher" FontSize="20" FontWeight="SemiBold" Foreground="#F0EEF8"/>
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="#8E8CA6"/>
            </StackPanel>
          </StackPanel>
          <Grid Margin="48,0,0,0" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="#F0EEF8" BorderThickness="0" CaretBrush="#B79CFF"
                     Padding="30,8,12,8" FontSize="15" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"/>
            <Rectangle x:Name="SearchLine" Height="1.5" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0.45">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00B79CFF" Offset="0"/>
                  <GradientStop Color="#FFB79CFF" Offset="0.15"/>
                  <GradientStop Color="#80B79CFF" Offset="0.7"/>
                  <GradientStop Color="#00B79CFF" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#8E8CA6" IsHitTestVisible="False"
                       Margin="4,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SearchHint" Text="Search your games  (name, number, EoSD…)   ·   Ctrl+F" IsHitTestVisible="False"
                       Foreground="#6E6C86" FontSize="15" Margin="32,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </DockPanel>
      </Border>
      <Border x:Name="BottomBar" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="0,6,0,12">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#600C0B18" Offset="0"/>
            <GradientStop Color="#F00C0B18" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#008B5CF6" Offset="0"/>
            <GradientStop Color="#508B5CF6" Offset="0.5"/>
            <GradientStop Color="#008B5CF6" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <StackPanel HorizontalAlignment="Center">
          <TextBlock x:Name="BottomHint" Height="20" FontSize="13" FontWeight="SemiBold" Foreground="#B79CFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="HomeBtn" Style="{StaticResource RoundBtn}" Content="&#xE80F;" Tag="Library"/>
            <Button x:Name="StatsBtn" Style="{StaticResource RoundBtn}" Content="&#xE9D2;" Tag="Stats"/>
            <Button x:Name="SettingsBtn" Style="{StaticResource RoundBtn}" Content="&#xE713;" Tag="Settings"/>
            <Button x:Name="HelpBtn" Style="{StaticResource RoundBtn}" Content="&#xE897;" Tag="Help"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="NoticeBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="22,9" Background="#3A2E1A" BorderBrush="#6B5422" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="NoticeClose" DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatBtn}" Padding="9,3" Margin="8,0,0,0" Background="Transparent" BorderBrush="#556B5422"/>
          <Button x:Name="NoticeAction" DockPanel.Dock="Right" Style="{StaticResource FlatBtn}" Padding="12,4" Margin="12,0,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="NoticeText" Foreground="#F5E6C4" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>
      <Border x:Name="NowPlaying" DockPanel.Dock="Top" Visibility="Collapsed" Padding="24,10"
              BorderBrush="#2C5A3E" BorderThickness="0,0,0,1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B3A2A" Offset="0"/>
            <GradientStop Color="#151826" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <StackPanel x:Name="NowPlayingPanel"/>
      </Border>
      <Grid>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Hidden" Padding="0" Focusable="False">
          <StackPanel>
            <Border x:Name="ContinueBanner" Visibility="Collapsed" Height="320" ClipToBounds="True"/>
            <DockPanel x:Name="LibBar" Margin="24,12,24,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SortBtn" Style="{StaticResource FlatBtn}" Padding="12,6"/>
              </StackPanel>
              <TextBlock x:Name="LibLabel" Foreground="#8E8CA6" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <StackPanel x:Name="GamePanel" Margin="0,0,0,24"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="StatsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" Padding="24,18" Background="Transparent">
          <StackPanel x:Name="StatsPanel" MaxWidth="1100"/>
        </ScrollViewer>
      </Grid>
    </DockPanel>

    <Grid x:Name="Overlay" Visibility="Collapsed" Background="#D90A0A14">
      <Border x:Name="Dialog" Width="860" MaxHeight="760" Background="#191A2E" CornerRadius="2" ClipToBounds="True"
              BorderBrush="#2E3050" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <DockPanel>
          <Grid x:Name="DlgHeaderGrid" DockPanel.Dock="Top" MinHeight="150">
            <Border x:Name="DlgHeader" CornerRadius="2,2,0,0"/>
            <Border x:Name="DlgShade" CornerRadius="2,2,0,0" Visibility="Collapsed">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#10000000" Offset="0"/>
                  <GradientStop Color="#40000000" Offset="0.45"/>
                  <GradientStop Color="#FF191A2E" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
              <Button x:Name="DlgFav" Content="☆" Style="{StaticResource FlatBtn}" Margin="0,0,8,0" Padding="11,5"
                      Background="#66000000" BorderBrush="#44FFFFFF" ToolTip="Favorite (F)"/>
              <Button x:Name="DlgClose" Content="✕" Style="{StaticResource FlatBtn}" Padding="11,5"
                      Background="#66000000" BorderBrush="#44FFFFFF" ToolTip="Close (Esc)"/>
            </StackPanel>
            <DockPanel Margin="26,20,26,18" VerticalAlignment="Bottom">
              <Image x:Name="DlgIcon" Width="44" Height="44" DockPanel.Dock="Left" Margin="0,0,16,2" VerticalAlignment="Bottom"/>
              <Button x:Name="DlgPlay" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" VerticalAlignment="Bottom" Margin="20,0,0,0"/>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="DlgSub" Foreground="#DDFFFFFF" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="DlgTitle" Foreground="White" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="DlgStats" Foreground="#D8FFFFFF" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap">
                  <TextBlock.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                </TextBlock>
              </StackPanel>
            </DockPanel>
          </Grid>
          <Border x:Name="DlgFooter" DockPanel.Dock="Bottom" Padding="22,12,22,16" BorderThickness="0,1,0,0">
            <Border.BorderBrush>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#008B5CF6" Offset="0"/>
                <GradientStop Color="#608B5CF6" Offset="0.5"/>
                <GradientStop Color="#008B5CF6" Offset="1"/>
              </LinearGradientBrush>
            </Border.BorderBrush>
            <DockPanel>
              <CheckBox x:Name="CustomChk" DockPanel.Dock="Left" Style="{StaticResource PillToggle}" Content="Game settings mode"
                        ToolTip="Open the game's own settings program (custom.exe) in the chosen language, instead of the game"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="VanillaBtn" Content="Play original" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Start the game without any thcrap patch"/>
                <Button x:Name="CoverBtn" Content="Cover…" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Pick this game's cover and banner from every option on SteamGridDB, or use your own picture"/>
                <Button x:Name="ReplaysBtn" Content="Replays" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Browse, rename, back up or delete this game's replays"/>
                <Button x:Name="SavesBtn" Content="Saves ▾" Style="{StaticResource FlatBtn}" Margin="8,0,0,0"
                        ToolTip="Back up / restore this game's save (score.dat), open its folders"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid>
            <ScrollViewer x:Name="LangScroll" VerticalScrollBarVisibility="Auto" Padding="21,14,21,10">
              <StackPanel>
                <TextBlock x:Name="LangHint" Foreground="#8E8CA6" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,8" TextWrapping="Wrap"/>
                <UniformGrid x:Name="LangPanel" Columns="3"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="CoverScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="22,14,12,10">
              <StackPanel x:Name="CoverPanel"/>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
    <Grid x:Name="SetupOverlay" Visibility="Collapsed" Background="#F20C0B18">
      <Border x:Name="SetupCard" Width="680" Background="#191A2E" CornerRadius="2" BorderBrush="#2E3050" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,30">
        <Border.Effect><DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
        <StackPanel x:Name="SetupPanel"/>
      </Border>
    </Grid>
  </Grid>
</Window>